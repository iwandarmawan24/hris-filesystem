# File Storage API Configuration

# Server
FILE_STORAGE_HOST=0.0.0.0
FILE_STORAGE_PORT=8080

# Storage path (should be mounted volume)
FILE_STORAGE_STORAGE_PATH=/data/files

# API Key for authentication (required for production)
FILE_STORAGE_API_KEY=your-secure-api-key-here

# Max file size in bytes (default 100MB)
FILE_STORAGE_MAX_FILE_SIZE=104857600
