# =============================================================================
# Encryption Service - Environment Variables
# =============================================================================

# Server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8081
DEBUG=false

# Vault
VAULT_ADDR=http://localhost:8200
VAULT_ROLE_ID=your-role-id-here
VAULT_SECRET_ID=your-secret-id-here
VAULT_MOUNT_PATH=transit
VAULT_KEY_NAME=hris-file-key

# Encryption
ENCRYPTION_ALGORITHM=AES-256-GCM
CHUNK_SIZE=65536

# Logging
LOG_LEVEL=INFO
