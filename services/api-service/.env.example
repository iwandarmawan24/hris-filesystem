# API Service Environment Configuration

# Server
NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://hris_user:your-password@postgres:5432/hris_db?schema=public&sslmode=require

# JWT Configuration
JWT_SECRET=your-jwt-secret-min-32-characters-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Service URLs
ENCRYPTION_SERVICE_URL=http://encryption-service:8000
FILE_STORAGE_API_URL=http://file-storage:8080

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# File Upload (100MB default)
MAX_FILE_SIZE=104857600
